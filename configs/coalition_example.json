{
  "run_name": "coalition_example",

  "geodata_path": "data/sample.geojson",

  "population_column": "total_pop_20",
  "population_vap_column": "total_vap_20",
  "pop_of_interest_column": "asian_nhpi_vap_20",

  "chain_length": 200,
  "num_subsamples": 2,
  "candidate_geometric_p": 0.2,

  "total_seats": 6,

  "district_configs": [
    { "num_districts": 3, "winners": 2 }
  ],

  "voting_configs": {
    "FastSTV": { "n_seats": 2, "tiebreak": "random" },
    "Plurality": { "n_seats": 2, "tiebreak": "random" }
  },

  "voter_models": ["slate_pl", "slate_bt"],

  "blocs": {
    "W-A": ["W", "A"],
    "B": ["B"],
    "H": ["H"]
  },

  "turnout": { "W-A": 0.6, "B": 0.75, "H": 0.55 },

  "num_voters": 500,

  "slate_to_candidates": {
    "W": ["W1", "W2"],
    "B": ["B1", "B2"],
    "H": ["H1"],
    "A": ["A1"]
  },

  "focal_group": "A",

  "cohesion_parameters": {
    "W-A": { "W": 0.50, "B": 0.10, "H": 0.10, "A": 0.30 },
    "B":   { "W": 0.10, "B": 0.70, "H": 0.10, "A": 0.10 },
    "H":   { "W": 0.15, "B": 0.10, "H": 0.70, "A": 0.05 }
  },

  "alphas": {
    "W-A": { "W": 1, "B": 1, "H": 1, "A": 1 },
    "B":   { "W": 1, "B": 1, "H": 1, "A": 1 },
    "H":   { "W": 1, "B": 1, "H": 1, "A": 1 }
  },



  "seed": 42
}
